# Copy to .env (git-ignored) for local development. Never commit real values.
# Use least-privilege tokens: read-only where possible, scoped to this project.

# Kaggle API (M1) — alternatively place kaggle.json in ~/.kaggle/ (outside the repo).
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face (M7) — a fine-grained token with write access to this project's repos only,
# used solely by the publication script after an explicit approval step.
HF_TOKEN=

# Research portal -> inference Space boundary (M8). Server-side only; never exposed to the browser.
INFERENCE_API_URL=
INFERENCE_API_TOKEN=

# Portal server only: authenticated read-only MQTT API. Never NEXT_PUBLIC_.
# DRIFTGUARD_STREAM_API_URL=https://your-authorized-backend.example
# DRIFTGUARD_DEMO_API_TOKEN=configure-in-secret-store
